{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/provider_status.py\" --event SessionStart --config \"${CLAUDE_PLUGIN_ROOT}/config/status_feeds.json\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/provider_status.py\" --event UserPromptSubmit --config \"${CLAUDE_PLUGIN_ROOT}/config/status_feeds.json\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/provider_status.py\" --event PostToolUseFailure --config \"${CLAUDE_PLUGIN_ROOT}/config/status_feeds.json\""
          }
        ]
      }
    ]
  }
}
